        "jsCode": "// Captura os headers retornados pelo HTTP Request\nconst headers = $json;\n\n// Lista de headers de segurança importantes\nconst checks = [\n  'content-security-policy',\n  'x-frame-options',\n  'x-content-type-options',\n  'strict-transport-security',\n  'referrer-policy',\n  'permissions-policy'\n];\n\n// Recupera a URL enviada pelo formulário\nconst url = $('On form submission').first().json['Insira o Link a ser analisado'];\n\n// Cria relatório com status de cada header\nconst report = checks.map(header => ({\n  header,\n  exists: !!headers[header],\n  value: headers[header] || '❌ Ausente'\n}));\n\n// Retorna para os próximos nós (IA / Email)\nreturn [{\n  url,\n  report\n}];\n"
